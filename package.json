{
  "name": "renkei-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "dev:server": "pnpm --filter @renkei/server dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "turbo": "2.10.11",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  },
  "type": "module"
}

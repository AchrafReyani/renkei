# Copy to .env (gitignored) for `supabase functions serve --env-file .env`.
# In production: `supabase secrets set --env-file .env` (then remove RENKEI_DEV).

# The function's public URL — locally the CLI's gateway, in production
# https://<project-ref>.supabase.co/functions/v1/renkei. renkei keeps this path on
# every URL it hands out; it is also the OIDC issuer.
ISSUER=http://127.0.0.1:54321/functions/v1/renkei
RENKEI_DEV=true

# LINE Login channel (LINE Developers Console → channel → Basic settings)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Pin both. The function runs in many isolates; keys generated per isolate would not match.
# Generate with `npx renkei init --print` in any directory, or see docs/reference/config.
RENKEI_JWKS=
RENKEI_COOKIE_KEYS=

# Storage: your project's Postgres. Every Edge Function gets SUPABASE_DB_URL for free
# (locally too), so nothing to set. To use the transaction pooler instead, or another
# Postgres, set DATABASE_URL — it takes precedence:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Your apps, once you go beyond the /dev test page (JSON array; see docs/reference/config):
# RENKEI_CLIENTS=[{"clientId":"my-app","clientSecret":"…","redirectUris":["https://my-app.example.com/api/renkei/callback"]}]

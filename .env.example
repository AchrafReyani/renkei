# Copy to .env. Required:
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Recommended (see docs/reference/config):
# ISSUER=https://auth.example.com
# DATABASE_URL=postgres://user:pass@host:5432/renkei
# RENKEI_COOKIE_KEYS=change-me-at-least-16-chars
# RENKEI_JWKS=[{"kty":"RSA",...}]
# RENKEI_CLIENTS=[{"clientId":"my-app","clientSecret":"...","redirectUris":["https://app.example.com/cb"]}]

# Optional:
# LINE_LOGIN_REGION=jp
# RENKEI_BOT_PROMPT=aggressive
# RENKEI_REQUEST_EMAIL=false
# RENKEI_CORS_ORIGINS=https://liff.example.com
# RENKEI_DEV=true
# LIFF_ID=
# LINE_MESSAGING_CHANNEL_ID=
# LINE_MESSAGING_CHANNEL_SECRET=

# Copy to .env. Required:
# (With more than one channel or client, `npx renkei init --yaml` moves all of this
#  into a committable renkei.yaml and leaves only the secrets here.
#  See docs/reference/config.en.md#renkeiyaml)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Recommended (see docs/reference/config):
# ISSUER=https://auth.example.com
# DATABASE_URL=postgres://user:pass@host:5432/renkei
# DATABASE_URL=sqlite:./data/renkei.db   # single-file SQLite (Node 22.13+), no database server
# RENKEI_COOKIE_KEYS=change-me-at-least-16-chars
# RENKEI_JWKS=[{"kty":"RSA",...}]
# RENKEI_CLIENTS=[{"clientId":"my-app","clientSecret":"...","redirectUris":["https://app.example.com/cb"]}]

# Optional:
# LINE_LOGIN_REGION=jp
# RENKEI_BOT_PROMPT=aggressive
# RENKEI_REQUEST_EMAIL=false
# RENKEI_CORS_ORIGINS=https://liff.example.com
# RENKEI_DEV=true
# LIFF_ID=
# RENKEI_CHANNELS=[{"channelId":"...","channelSecret":"...","region":"tw"}]   # more channels: another region, a MINI App (docs/tutorials/multi-region)
# LINE_MESSAGING_CHANNEL_REGION=jp    # which Login channel's users the webhook events concern
# LINE_MINIAPP_CHANNEL_ID=            # LINE MINI App channel(s) of the same provider, comma-separated per stage (docs/guides/line-mini-app)
# LINE_MINIAPP_CHANNEL_SECRET=
# LINE_MESSAGING_CHANNEL_ID=
# LINE_MESSAGING_CHANNEL_SECRET=

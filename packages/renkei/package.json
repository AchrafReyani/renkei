{
  "name": "renkei",
  "version": "0.2.0",
  "description": "renkei (連携) — self-hosted identity broker for LINE. `npx renkei` starts the server.",
  "license": "Apache-2.0",
  "author": "Achraf Reyani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AchrafReyani/renkei.git",
    "directory": "packages/renkei"
  },
  "keywords": [
    "line",
    "line-login",
    "liff",
    "oidc",
    "openid-connect",
    "identity",
    "japan"
  ],
  "type": "module",
  "bin": {
    "renkei": "./bin/renkei.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "bin",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node --check bin/renkei.js"
  },
  "dependencies": {
    "renkei-server": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

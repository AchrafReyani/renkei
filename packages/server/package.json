{
  "name": "@renkei/server",
  "version": "0.0.0",
  "description": "renkei server: LINE-facing login flow on one side, a standard OpenID Connect provider on the other. Hono + oidc-provider.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AchrafReyani/renkei.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --clean --sourcemap",
    "dev": "node --env-file=../../.env --import tsx src/node.ts",
    "dev:harness": "node --env-file=../../.env --import tsx src/dev-harness.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@renkei/core": "workspace:*",
    "@renkei/storage-postgres": "workspace:*",
    "hono": "^4.13.4",
    "jose": "^6.2.10",
    "oidc-provider": "^9.11.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/oidc-provider": "^9.5.0",
    "tsx": "^4.20.0"
  }
}
